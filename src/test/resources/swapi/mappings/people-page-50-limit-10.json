{
  "request": {
    "method": "GET",
    "urlPath": "/api/people",
    "queryParameters": {
      "page": { "equalTo": "50" },
      "limit": { "equalTo": "10" }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json; charset=utf-8"
    },
    "bodyFileName": "people-page-50-limit-10.json"
  }
}
