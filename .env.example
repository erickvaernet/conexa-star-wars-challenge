# Development values for docker compose. They are not secrets.
# Copy this file to .env to change them; .env is never committed.

# Database credentials, used by both the database and the application.
DB_USER=starwars
DB_PASSWORD=starwars

# Key that signs the login tokens: at least 32 characters. This one is public, so it is only for
# local use; anywhere else, set a key of your own.
JWT_SECRET=local-development-signing-key-change-me

# Minutes until a token expires.
JWT_TTL_MINUTES=60

# Loads the test user "demo". Switch it off wherever real users exist.
SEED_ENABLED=true

# Port where the application is published on this machine.
APP_PORT=8080
