# Development values for docker compose. They are not secrets.
# Copy this file to .env to change them; .env is never committed.

# Database credentials, used by both the database and the application.
DB_USER=starwars
DB_PASSWORD=starwars

# Key that signs the login tokens: at least 32 characters. This one is public, so it is only for
# local use; anywhere else, set a key of your own.
JWT_SECRET=local-development-signing-key-change-me

# Minutes until a token expires.
JWT_TTL_MINUTES=60

# Loads the test users, "demo" and "admin". Switch it off wherever real users exist.
SEED_ENABLED=true

# Address of SWAPI, the source of the Star Wars data.
SWAPI_BASE_URL=https://www.swapi.tech/api

# The longest the application waits for SWAPI: to connect, and for the answer once connected.
# A number with its unit: 500ms, 3s, 1m.
SWAPI_CONNECT_TIMEOUT=3s
SWAPI_READ_TIMEOUT=10s

# A request to SWAPI that fails in a way that usually goes away by itself is sent again: how many
# times (from 0 to 3; with 0, never) and how long after the failure (200ms, 1s; 0s is "at once").
SWAPI_MAX_RETRIES=1
SWAPI_RETRY_DELAY=200ms

# Cache of the answers of SWAPI: how long an answer is kept (30m, 1h) and how many are kept at most.
SWAPI_CACHE_TTL=1h
SWAPI_CACHE_MAX_SIZE=500

# Port where the application is published on this machine.
APP_PORT=8080
