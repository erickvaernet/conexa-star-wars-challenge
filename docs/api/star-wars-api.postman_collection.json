    {
      "name": "6. Errors",
      "item": [
        {
          "name": "No token - 401",
          "request": {
            "description": "A list asked for without the token. It is the only request, besides the logins, that does not send it.",
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/people",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "people"
              ]
            }
          }
        },
        {
          "name": "Create a user as demo - 403",
          "request": {
            "description": "Only an administrator can create users. This request goes with the token of demo, a common user, so it has to run before the login of admin.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"leia\",\n  \"password\": \"alderaan-1977\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ]
            }
          }
        },
        {
          "name": "Invalid parameter - 400 with errors",
          "request": {
            "description": "A size outside its range. The answer says which parameter to correct, in `detail` and in the list `errors`.",
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/people?size=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "people"
              ],
              "query": [
                {
                  "key": "size",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "Element that does not exist - 404",
          "request": {
            "description": "The detail of an identifier that no character has.",
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/people/9999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "people",
                "9999"
              ]
            }
          }
        }
      ]
