{
  "info": {
    "name": "Star Wars API",
    "description": "The whole flow of the API, in order: log in, list and filter the four entities, the errors worth seeing, and the creation of a user.\n\nRun the requests from top to bottom. Each login saves its token in the variable `token`, and every other request sends it by itself.\n\nTo use another address, change the variable `baseUrl`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Log in",
      "item": [
        {
          "name": "Log in as demo - 200, saves the token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"token\", pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "description": "The test user with the role USER. The answer brings the token, and the script of this request saves it in the variable `token`.",
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo\",\n  \"password\": \"demo1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. People",
      "item": [
        {
          "name": "People - list one page - 200",
          "request": {
            "description": "The first five characters, each with its identifier and its name, and the totals of the list.",
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/people?page=1&size=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "people"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "size",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "People - filter by ID - 200",
          "request": {
            "description": "A list with one element, Luke Skywalker. An identifier that does not exist answers 200 with an empty list.",
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/people?id=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "people"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "People - filter by name - 200",
          "request": {
            "description": "The characters whose name contains the text, in upper or lower case.",
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/people?name=sky",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "people"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "sky"
                }
              ]
            }
          }
        },
        {
          "name": "People - list with the complete data - 200",
          "request": {
            "description": "The same page, where each element is the object that the detail answers instead of the summary.",
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/people?expanded=true&size=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "people"
              ],
              "query": [
                {
                  "key": "expanded",
                  "value": "true"
                },
                {
                  "key": "size",
                  "value": "2"
                }
              ]
            }
          }
        },
        {
          "name": "People - detail - 200",
          "request": {
            "description": "The complete data of Luke Skywalker.",
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/people/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "people",
                "1"
              ]
            }
          }
        }
      ]
    },
